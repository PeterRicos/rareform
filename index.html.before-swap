  <!-- MODAL SHADE / OVERLAY -->
  <div class="overlay" id="shade" onclick="closeAllDrawers()"></div>

  <!-- CART DRAWER -->
  <aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Shopping Bag">
    <div class="drawer-head">
      <span>YOUR BAG <span id="drawerCount">(0)</span></span>
      <button class="drawer-close" onclick="cartClose()" aria-label="Close bag">×</button>
    </div>
    <div class="drawer-list" id="cartList"></div>
    <div class="drawer-foot">
      <small id="shippingText" style="font-size:12px;display:block;margin-bottom:6px">You're $150 away from FREE SHIPPING.</small>
      <div class="shipping-bar-wrap">
        <div class="shipping-bar" id="shippingBar"></div>
      </div>
      <div class="total-line">
        <span>Subtotal</span>
        <b id="subtotal">$0</b>
      </div>
      <div class="total-line">
        <span>Estimated Shipping</span>
        <span id="shipping">$0</span>
      </div>
      <div class="total-line bold">
        <span>Estimated Total</span>
        <span id="estimatedTotal">$0</span>
      </div>
      <button class="btn" style="width:100%;margin-top:16px" onclick="checkoutBag()">PROCEED TO CHECKOUT</button>
    </div>
  </aside>

  <!-- SEARCH MODAL -->
  <section class="search-modal" id="searchModal" role="dialog" aria-modal="true" aria-label="Global Search">
    <button class="search-modal-close" onclick="searchClose()" aria-label="Close search">×</button>
    <div class="search-bar">
      <input id="globalSearch" placeholder="Search sneakers, SKU, brand..." oninput="globalSearch()" autocomplete="off">
    </div>
    <div class="suggestions">
      <span class="eyebrow">Popular Searches</span>
      <div class="suggestions-chips">
        <button onclick="setSearch('Jordan')">Air Jordan</button>
        <button onclick="setSearch('Dunk')">Nike Dunk</button>
        <button onclick="setSearch('Travis Scott')">Travis Scott</button>
        <button onclick="setSearch('New Balance')">New Balance 990</button>
        <button onclick="setSearch('Supreme')">Supreme</button>
      </div>
      <div id="searchResults" class="products" style="margin-top:35px"></div>
    </div>
  </section>

