<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Random Stock — Verified Sneakers & Streetwear</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #151515;
      --paper: #f5f4f1;
      --paper-subtle: #eae9e5;
      --white: #ffffff;
      --line: #dedcd7;
      --muted: #4f4d49;
      --lime: #d7ff3f;
      --radius: 4px;
      --transition: 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 14px/1.5 'Manrope', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; border: 0; background: transparent; }
    a { color: inherit; text-decoration: none; cursor: pointer; }
    img { width: 100%; display: block; object-fit: cover; }
    :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

    .mono { font-family: 'DM Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase; }
    .eyebrow {
      font: 11px/1.3 'DM Mono', monospace;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 500;
    }

    /* Announcement Bar */
    .announce {
      height: 38px;
      background: var(--ink);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      font: 11px/1 'DM Mono', monospace;
      letter-spacing: 0.12em;
      padding: 0 45px;
      text-align: center;
      z-index: 25;
    }
    .announce button {
      position: absolute;
      right: 18px;
      color: #fff;
      font-size: 18px;
      line-height: 1;
      padding: 4px 8px;
      opacity: 0.8;
      transition: var(--transition);
    }
    .announce button:hover { opacity: 1; }
    .announce.hide { display: none; }

    /* Navigation */
    .nav {
      height: 76px;
      padding: 0 clamp(18px, 4vw, 56px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      background: rgba(245, 244, 241, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      position: sticky;
      top: 0;
      z-index: 30;
    }
    .logo {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -1.4px;
      display: inline-flex;
      align-items: center;
      user-select: none;
    }
    .logo i { font-style: normal; color: #777; font-weight: 700; }
    .nav-links {
      display: flex;
      gap: 28px;
      margin-left: 45px;
      flex: 1;
    }
    .nav-links a {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      position: relative;
      padding: 8px 0;
      color: var(--ink);
      transition: color var(--transition);
    }
    .nav-links a:hover, .nav-links a.active {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 8px;
    }
    .actions { display: flex; gap: 14px; align-items: center; }
    .icon-btn {
      background: none;
      padding: 6px;
      font-size: 18px;
      line-height: 1;
      color: var(--ink);
      position: relative;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background var(--transition);
    }
    .icon-btn:hover { background: rgba(0,0,0,0.05); }
    .badge {
      position: absolute;
      right: -4px;
      top: -3px;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      border-radius: 999px;
      font: 9px/16px 'DM Mono', monospace;
      text-align: center;
      background: var(--ink);
      color: #fff;
      pointer-events: none;
    }
    .hamb {
      display: none;
      font-size: 22px;
      padding: 6px;
      margin-right: 8px;
    }

    /* Page View Controller */
    .page { display: none; }
    .page.active { display: block; animation: fadeIn 0.25s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

    /* Hero Section */
    .hero {
      min-height: calc(100vh - 114px);
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      background: #dfdeda;
      position: relative;
      border-bottom: 1px solid var(--line);
    }
    .hero-copy {
      padding: clamp(48px, 8vw, 130px) clamp(22px, 6vw, 90px);
      align-self: center;
    }
    .hero h1 {
      font-size: clamp(46px, 6.2vw, 98px);
      line-height: 0.92;
      letter-spacing: -0.075em;
      margin: 20px 0 24px;
      max-width: 720px;
      font-weight: 800;
    }
    .hero p {
      max-width: 420px;
      color: #3b3936;
      font-size: 15px;
      line-height: 1.65;
      margin-bottom: 34px;
    }
    .hero-image {
      min-height: 520px;
      position: relative;
      overflow: hidden;
      background: #cfceca;
    }
    .hero-image img {
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero:hover .hero-image img { transform: scale(1.03); }
    .hero-stamp {
      position: absolute;
      bottom: 28px;
      right: 28px;
      color: #fff;
      background: rgba(21, 21, 21, 0.9);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 110px;
      height: 110px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font: 9px/1.35 'DM Mono', monospace;
      letter-spacing: 0.12em;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.22);
      user-select: none;
    }

    /* Shared Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--ink);
      color: #fff;
      border: 1px solid var(--ink);
      padding: 14px 26px;
      font: 11px/1 'Manrope', sans-serif;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      border-radius: var(--radius);
      transition: var(--transition);
      cursor: pointer;
    }
    .btn:hover {
      background: #2b2b2b;
      border-color: #2b2b2b;
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    }
    .btn.light {
      background: transparent;
      color: var(--ink);
      border-color: var(--ink);
    }
    .btn.light:hover {
      background: var(--ink);
      color: #fff;
      transform: translateY(-2px);
    }
    .btn.white {
      background: #fff;
      color: var(--ink);
      border-color: #fff;
    }
    .btn.white:hover {
      background: var(--paper);
      border-color: var(--paper);
      transform: translateY(-2px);
    }
    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }

    /* Layout Sections */
    .section {
      padding: clamp(55px, 6.5vw, 100px) clamp(18px, 4vw, 56px);
      max-width: 1600px;
      margin: auto;
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 32px;
      gap: 16px;
    }
    .section h2 {
      font-size: clamp(32px, 4.2vw, 56px);
      letter-spacing: -0.065em;
      line-height: 1;
      margin: 8px 0 0;
      font-weight: 800;
    }
    .text-link {
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px solid;
      padding-bottom: 4px;
      color: var(--ink);
      transition: opacity var(--transition);
      white-space: nowrap;
    }
    .text-link:hover { opacity: 0.7; }

    /* Product Grid & Cards */
    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
    .product {
      min-width: 0;
      position: relative;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .product:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.06);
    }
    .product-image {
      background: #edece9;
      aspect-ratio: 1;
      overflow: hidden;
      position: relative;
      cursor: pointer;
    }
    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain; /* never crop — the whole sneaker stays visible */
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product:hover .product-image img { transform: scale(1.06); }
    .tag {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--ink);
      color: #fff;
      padding: 4px 8px;
      font: 9px/1.2 'DM Mono', monospace;
      letter-spacing: 0.08em;
      border-radius: 2px;
      z-index: 2;
    }
    .p-info {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .p-info .brand {
      font: 10px/1.2 'DM Mono', monospace;
      color: var(--muted);
      text-transform: uppercase;
      font-weight: 500;
    }
    .p-info .name {
      font-weight: 800;
      font-size: 14px;
      margin: 5px 0 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      cursor: pointer;
    }
    .p-info .name:hover { text-decoration: underline; }
    .p-info .color, .p-info .sizes {
      color: var(--muted);
      font-size: 11px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .p-info .price-row {
      margin-top: auto;
      padding-top: 12px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .price { font-weight: 800; font-size: 15px; }
    .retail {
      color: #92908c;
      text-decoration: line-through;
      font-size: 11px;
      font-weight: 500;
    }
    .quick {
      width: 100%;
      margin-top: 12px;
      padding: 10px 12px;
      background: var(--ink);
      color: #fff;
      font: 10px/1 'Manrope', sans-serif;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      border-radius: var(--radius);
      transition: var(--transition);
      opacity: 0.9;
    }
    .quick:hover {
      background: #2c2c2c;
      opacity: 1;
    }

    /* Brand Grid Section */
    .brand-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 10px;
    }
    .brand-tile {
      height: 120px;
      background: #eae9e5;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      display: grid;
      place-items: center;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      transition: var(--transition);
      cursor: pointer;
      padding: 12px;
      text-align: center;
      user-select: none;
    }
    .brand-tile:hover, .brand-tile.selected {
      background: var(--lime);
      border-color: #b4db1b;
      transform: translateY(-3px);
      box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }

    /* Heat Section */
    .heat {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      min-height: 600px;
      background: var(--ink);
      color: #fff;
    }
    .heat-main {
      position: relative;
      overflow: hidden;
      min-height: 420px;
    }
    .heat-main img {
      height: 100%;
      width: 100%;
      object-fit: cover;
      opacity: 0.85;
      transition: transform 1.2s ease;
    }
    .heat:hover .heat-main img { transform: scale(1.04); }
    .heat-main .overlay {
      position: absolute;
      left: clamp(24px, 5vw, 64px);
      bottom: clamp(32px, 5vw, 64px);
      z-index: 2;
    }
    .heat-main::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(21,21,21,0.85) 0%, rgba(21,21,21,0.2) 60%);
      pointer-events: none;
    }
    .heat h2 {
      font-size: clamp(38px, 5vw, 72px);
      letter-spacing: -0.06em;
      line-height: 0.95;
      margin: 12px 0 24px;
      max-width: 520px;
      font-weight: 800;
    }
    .heat-side {
      padding: clamp(32px, 5vw, 64px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border-left: 1px solid #292929;
    }
    .heat-side p {
      color: #c4c4c0;
      max-width: 310px;
      line-height: 1.7;
      font-size: 14px;
      margin: 14px 0 0;
    }
    .heat-count { font: 11px 'DM Mono', monospace; color: var(--lime); font-weight: 500; }

    /* Authenticity Banner */
    .auth {
      background: #e3e0da;
      max-width: none;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .auth-inner { max-width: 1488px; margin: auto; }
    .auth-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 6vw;
      align-items: center;
    }
    .auth h2 {
      font-size: clamp(38px, 4.8vw, 70px);
      letter-spacing: -0.06em;
      line-height: 0.98;
      max-width: 660px;
      margin: 10px 0 18px;
    }
    .auth p {
      color: #3f3e3a;
      max-width: 460px;
      font-size: 15px;
      line-height: 1.6;
    }
    .steps { border-top: 1px solid #a8a49c; margin-top: 10px; }
    .step {
      display: flex;
      align-items: center;
      gap: 24px;
      padding: 18px 0;
      border-bottom: 1px solid #a8a49c;
    }
    .step b { font: 12px 'DM Mono', monospace; color: #555; }
    .step span { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; }

    /* Streetwear Feature */
    .streetwear {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .feature-card {
      position: relative;
      width: 100%;
      min-height: 480px;
      color: #fff;
      overflow: hidden;
      border-radius: var(--radius);
      display: flex;
      align-items: flex-end;
      padding: clamp(28px, 5vw, 60px);
    }
    .feature-card img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
      object-position: center 30%;
      transition: transform 1s ease;
    }
    .feature-card:hover img { transform: scale(1.03); }
    .feature-card::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.05) 100%);
    }
    .feature-card .content {
      position: relative;
      z-index: 2;
      max-width: 580px;
    }
    .feature-card h3 {
      font-size: clamp(32px, 4.5vw, 54px);
      letter-spacing: -0.06em;
      line-height: 1;
      margin: 10px 0 20px;
    }

    /* Supreme portrait shot: show the whole photo (no crop / no zoom) */
    .feature-card.full-shot { min-height: clamp(520px, 64vh, 700px); }
    .feature-card.full-shot::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url('supreme.jpg') center / cover no-repeat;
      filter: blur(20px);
      transform: scale(1.1);
    }
    .feature-card.full-shot img { object-fit: contain; }
    .feature-card.full-shot:hover img { transform: none; }

    /* Newsletter */
    .newsletter {
      background: #fff;
      border-top: 1px solid var(--line);
      padding: 65px clamp(18px, 4vw, 56px);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 36px;
      flex-wrap: wrap;
    }
    .newsletter h2 {
      font-size: clamp(28px, 3.5vw, 42px);
      letter-spacing: -0.06em;
      margin: 8px 0 6px;
    }
    .newsletter p { color: #555; margin: 0; font-size: 14px; }
    .email-form {
      display: flex;
      width: min(100%, 480px);
    }
    .email-form input {
      padding: 14px 18px;
      border: 1px solid var(--ink);
      border-right: 0;
      background: transparent;
      flex: 1;
      min-width: 0;
      border-radius: var(--radius) 0 0 var(--radius);
      font-size: 13px;
    }
    .email-form button {
      padding: 0 22px;
      background: var(--ink);
      color: #fff;
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 0.08em;
      border-radius: 0 var(--radius) var(--radius) 0;
      transition: background var(--transition);
    }
    .email-form button:hover { background: #333; }

    /* Footer */
    .footer {
      background: var(--ink);
      color: #fff;
      padding: 64px clamp(18px, 4vw, 56px) 28px;
    }
    .foot-grid {
      display: grid;
      grid-template-columns: 2fr repeat(3, 1fr);
      gap: 32px;
      max-width: 1600px;
      margin: auto;
    }
    .foot-grid h4 {
      font: 11px 'DM Mono', monospace;
      color: #aaa;
      letter-spacing: 0.1em;
      margin: 0 0 16px;
      text-transform: uppercase;
    }
    .foot-grid a {
      display: block;
      margin: 9px 0;
      font-size: 13px;
      color: #dfdedc;
      transition: color var(--transition);
    }
    .foot-grid a:hover { color: #fff; text-decoration: underline; }
    .foot-bottom {
      border-top: 1px solid #333;
      margin-top: 56px;
      padding-top: 22px;
      font: 11px 'DM Mono', monospace;
      color: #b0ada6;
      display: flex;
      justify-content: space-between;
      max-width: 1600px;
      margin-left: auto;
      margin-right: auto;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* Shop View */
    .shop-top {
      padding: 50px clamp(18px, 4vw, 56px) 20px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      max-width: 1600px;
      margin: auto;
    }
    .shop-top h1, .about h1 {
      font-size: clamp(42px, 6vw, 84px);
      letter-spacing: -0.08em;
      line-height: 0.92;
      margin: 10px 0 0;
      font-weight: 800;
    }
    .shop-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 40px;
    }
    .filters {
      border-top: 1px solid var(--line);
    }
    .filter {
      border-bottom: 1px solid var(--line);
      padding: 18px 0;
    }
    .filter label {
      font: 11px/1 'DM Mono', monospace;
      letter-spacing: 0.08em;
      font-weight: 700;
      display: block;
      margin-bottom: 10px;
      color: var(--ink);
    }
    .filter select, .filter input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d0cdc6;
      background: #fff;
      border-radius: var(--radius);
      font-size: 13px;
    }
    .shop-actions {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      justify-content: space-between;
    }
    .shop-actions input {
      padding: 11px 16px;
      border: 1px solid #ccc;
      background: #fff;
      flex: 1;
      max-width: 360px;
      border-radius: var(--radius);
      font-size: 13px;
    }
    .shop-actions select {
      padding: 11px 16px;
      border: 1px solid #ccc;
      background: #fff;
      border-radius: var(--radius);
      font-size: 13px;
    }
    .clear-filters-btn {
      margin-top: 18px;
      width: 100%;
      padding: 10px;
      font: 10px 'DM Mono', monospace;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 1px dashed var(--muted);
      border-radius: var(--radius);
      color: var(--ink);
    }
    .clear-filters-btn:hover { background: #eae8e3; }

    /* Product Detail View */
    .product-page {
      padding: 36px clamp(18px, 4vw, 56px) 90px;
      max-width: 1480px;
      margin: auto;
    }
    .back {
      font: 11px 'DM Mono', monospace;
      letter-spacing: 0.08em;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 24px;
      color: var(--ink);
    }
    .back:hover { text-decoration: underline; }
    .detail {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 5vw;
    }
    .gallery {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .gallery img {
      aspect-ratio: 1;
      object-fit: contain; /* never crop — the whole sneaker stays visible */
      background: #e7e5e0;
      border-radius: var(--radius);
      border: 1px solid var(--line);
    }
    /* Single-photo listings: span the full gallery width */
    .gallery img:only-child { grid-column: 1 / -1; }
    .details {
      position: sticky;
      top: 100px;
      align-self: start;
    }
    .details h1 {
      font-size: clamp(32px, 3.8vw, 48px);
      letter-spacing: -0.06em;
      line-height: 1.05;
      margin: 8px 0;
      font-weight: 800;
    }
    .detail-price {
      font-size: 26px;
      font-weight: 800;
      margin: 18px 0 16px;
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .meta {
      font-size: 12px;
      color: var(--muted);
      line-height: 2;
      border-top: 1px solid var(--line);
      padding-top: 16px;
      font-family: 'DM Mono', monospace;
    }
    .size-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin: 12px 0 24px;
    }
    .size-btn {
      padding: 12px 6px;
      background: #fff;
      border: 1px solid #ccc;
      border-radius: var(--radius);
      font-weight: 700;
      font-size: 13px;
      transition: var(--transition);
      text-align: center;
    }
    .size-btn:hover { border-color: var(--ink); }
    .size-btn.selected {
      background: var(--ink);
      color: #fff;
      border-color: var(--ink);
    }
    .detail-btns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 8px;
    }
    .detail-btns .btn:first-child { grid-column: span 2; padding: 16px; font-size: 12px; }
    .perks {
      margin: 28px 0;
      border-top: 1px solid var(--line);
    }
    .perks p {
      margin: 0;
      border-bottom: 1px solid var(--line);
      padding: 12px 0;
      font-size: 13px;
      color: #333;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .perks p b { color: #151515; }

    /* About View */
    .about {
      padding: 70px clamp(18px, 8vw, 130px) 100px;
      max-width: 1400px;
      margin: auto;
    }
    .about > p {
      max-width: 620px;
      font-size: 18px;
      line-height: 1.7;
      margin: 28px 0 45px;
      color: #333;
    }
    .about-hero {
      height: 480px;
      margin: 50px 0;
      border-radius: var(--radius);
      overflow: hidden;
    }
    .about-hero img { height: 100%; object-fit: cover; }

    /* Modals & Drawers */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(20, 20, 20, 0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 40;
    }
    .overlay.open { opacity: 1; pointer-events: auto; }

    .drawer {
      position: fixed;
      right: 0;
      top: 0;
      height: 100dvh;
      width: min(440px, 100%);
      background: #fff;
      z-index: 50;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 35px rgba(0,0,0,0.15);
    }
    .drawer.open { transform: none; }
    .drawer-head {
      padding: 22px;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.02em;
    }
    .drawer-close {
      font-size: 24px;
      line-height: 1;
      padding: 4px 8px;
      color: var(--ink);
    }
    .drawer-close:hover { opacity: 0.7; }
    .drawer-list {
      padding: 22px;
      overflow-y: auto;
      flex: 1;
    }
    .cart-row {
      display: grid;
      grid-template-columns: 86px 1fr;
      gap: 14px;
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--line);
    }
    .cart-row:last-child { border-bottom: 0; margin-bottom: 0; }
    .cart-row img {
      width: 86px;
      height: 86px;
      border-radius: var(--radius);
      background: #f0eee9;
    }
    .cart-row .item-title { font-size: 13px; font-weight: 800; margin-bottom: 2px; }
    .cart-row small { display: block; color: var(--muted); font-size: 11px; margin-bottom: 6px; }
    .cart-row .price-tag { font-weight: 800; font-size: 14px; }
    .qty-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
    }
    .qty-btn {
      border: 1px solid #ccc;
      background: #fff;
      width: 24px;
      height: 24px;
      border-radius: 2px;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 12px;
      line-height: 1;
      cursor: pointer;
    }
    .qty-btn:hover { border-color: var(--ink); }
    .qty-num { font-size: 13px; font-weight: 700; min-width: 18px; text-align: center; }
    .item-remove {
      margin-left: auto;
      font-size: 11px;
      color: #777;
      text-decoration: underline;
      cursor: pointer;
    }
    .item-remove:hover { color: #d00; }
    .drawer-foot {
      border-top: 1px solid var(--line);
      padding: 22px;
      background: #fcfbf9;
    }
    .total-line {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      margin: 8px 0;
    }
    .total-line.bold { font-size: 16px; font-weight: 800; margin-top: 12px; }
    .shipping-bar-wrap {
      height: 6px;
      background: #e5e3de;
      border-radius: 999px;
      overflow: hidden;
      margin: 8px 0 16px;
    }
    .shipping-bar {
      height: 100%;
      background: var(--lime);
      width: 0%;
      transition: width 0.35s ease;
    }

    /* Mobile Menu Drawer */
    .mobile-drawer {
      position: fixed;
      left: 0;
      top: 0;
      height: 100dvh;
      width: min(320px, 85%);
      background: #fff;
      z-index: 50;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      box-shadow: 8px 0 35px rgba(0,0,0,0.15);
    }
    .mobile-drawer.open { transform: none; }
    .mobile-drawer-head {
      padding: 22px;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .mobile-links {
      display: flex;
      flex-direction: column;
      padding: 24px;
      gap: 18px;
    }
    .mobile-links a {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Search Modal */
    .search-modal {
      position: fixed;
      inset: 0;
      background: var(--paper);
      z-index: 60;
      transform: translateY(-100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      padding: 30px clamp(20px, 8vw, 120px);
      overflow-y: auto;
    }
    .search-modal.open { transform: none; }
    .search-modal-close {
      position: absolute;
      right: clamp(20px, 4vw, 50px);
      top: 25px;
      font-size: 32px;
      line-height: 1;
      padding: 8px;
      color: var(--ink);
    }
    .search-bar {
      display: flex;
      border-bottom: 2px solid var(--ink);
      margin-top: 75px;
      padding-bottom: 8px;
    }
    .search-bar input {
      font-size: clamp(26px, 4.5vw, 52px);
      letter-spacing: -0.06em;
      border: 0;
      background: none;
      outline: 0;
      width: 100%;
      font-weight: 700;
    }
    .suggestions { margin-top: 32px; }
    .suggestions-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 12px;
    }
    .suggestions button {
      background: #fff;
      border: 1px solid var(--line);
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      transition: var(--transition);
    }
    .suggestions button:hover {
      background: var(--ink);
      color: #fff;
      border-color: var(--ink);
    }

    /* Toast */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 28px;
      transform: translate(-50%, 120px);
      background: var(--ink);
      color: #fff;
      padding: 12px 20px;
      z-index: 90;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.4;
      text-align: center;
      border-radius: 999px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      max-width: min(480px, calc(100vw - 32px));
      width: max-content;
      box-sizing: border-box;
    }
    .toast.show { transform: translate(-50%, 0); }

    /* Responsive Queries */
    @media (max-width: 1024px) {
      .products { grid-template-columns: repeat(3, 1fr); }
      .brand-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 820px) {
      .nav { height: 66px; }
      .nav-links { display: none; }
      .hamb { display: block; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-copy { padding: 50px 20px 40px; order: 1; }
      .hero-image { min-height: 340px; order: 2; }
      .hero-stamp { width: 90px; height: 90px; font-size: 8px; bottom: 18px; right: 18px; }
      .products { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .p-info { padding: 12px; }
      .brand-grid { grid-template-columns: repeat(2, 1fr); }
      .brand-tile { height: 80px; font-size: 13px; }
      .heat, .auth-grid { grid-template-columns: 1fr; }
      .heat { min-height: auto; }
      .heat-main { min-height: 320px; }
      .heat-side { border-left: 0; border-top: 1px solid #292929; }
      .newsletter { padding: 45px 20px; }
      .foot-grid { grid-template-columns: 1fr 1fr; }
      .foot-grid > div:first-child { grid-column: span 2; }
      .shop-layout { grid-template-columns: 1fr; }
      .filters { display: none; }
      .shop-actions { flex-direction: column; }
      .shop-actions input { max-width: none; }
      .detail { grid-template-columns: 1fr; }
      .details { position: static; }
      .product-page { padding: 25px 18px 60px; }
      .gallery { gap: 8px; }
    }
    @media (max-width: 480px) {
      .products { grid-template-columns: 1fr; }
      .hero h1 { font-size: 38px; }
      .foot-grid { grid-template-columns: 1fr; }
      .foot-grid > div:first-child { grid-column: span 1; }
      .toast { border-radius: 16px; padding: 12px 18px; }
    }
  </style>
</head>
<body>

  <!-- Announcement Bar -->
  <aside class="announce" id="announce" role="region" aria-label="Announcement">
    <span>ORDERS SHIP WITHIN 1-2 BUSINESS DAYS · 100% AUTHENTICITY GUARANTEE</span>
    <button onclick="document.getElementById('announce').classList.add('hide')" aria-label="Dismiss announcement">×</button>
  </aside>

  <!-- Navigation Header -->
  <header>
    <nav class="nav" aria-label="Main Navigation">
      <div style="display: flex; align-items: center;">
        <button class="hamb" onclick="menuOpen()" aria-label="Open mobile menu" aria-expanded="false" id="hambBtn">☰</button>
        <a class="logo" href="#home" onclick="event.preventDefault(); go('home');">RANDOM&nbsp;<i>STOCK</i></a>
      </div>

      <div class="nav-links">
        <a onclick="shopNav('all')" href="#shop">New Arrivals</a>
        <a onclick="shopNav('all')" href="#shop">Sneakers</a>
        <a onclick="scrollToSection('street')" href="#street">Streetwear</a>
        <a onclick="scrollToSection('heat')" href="#heat">Collections</a>
        <a onclick="go('about')" href="#about">About</a>
      </div>

      <div class="actions">
        <button class="icon-btn" onclick="searchOpen()" aria-label="Open search">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <button class="icon-btn" onclick="cartOpen()" aria-label="Open shopping bag">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 15.4H19.5A1.9 1.9 0 0 1 21.4 17.3A1.9 1.9 0 0 1 19.5 19.2H4.5A1.9 1.9 0 0 1 2.6 17.3A1.9 1.9 0 0 1 4.5 15.4Z"/><path d="M19.8 15.4C19.8 13.4 18.7 11.7 16.8 11C14.9 10.3 13.9 10.4 13.1 10.1C12.1 9.8 11.3 9.4 10.7 8.7C10.2 8.3 9.6 8.5 9.2 9.3C8.9 9.9 8.6 10.4 8.4 10.8C7.9 9.9 7 8.6 6.2 7.8C5 6.8 3.8 7 3.4 8.2C3.2 8.8 3.2 9.6 3.2 10.4V15.4Z"/></svg>
          <span class="badge" id="cartCount">0</span>
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile Menu Drawer -->
  <aside class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="mobile-drawer-head">
      <span class="logo">RANDOM&nbsp;<i>STOCK</i></span>
      <button class="drawer-close" onclick="menuClose()" aria-label="Close menu">×</button>
    </div>
    <nav class="mobile-links">
      <a onclick="menuClose(); shopNav('all')">New Arrivals <span>→</span></a>
      <a onclick="menuClose(); shopNav('all')">Sneakers <span>→</span></a>
      <a onclick="menuClose(); scrollToSection('street')">Streetwear <span>→</span></a>
      <a onclick="menuClose(); scrollToSection('heat')">Collections <span>→</span></a>
      <a onclick="menuClose(); go('about')">About Random Stock <span>→</span></a>
    </nav>
  </aside>

  <!-- MAIN CONTENT CONTAINER -->
  <main id="main">
    <!-- HOME PAGE -->
    <div id="home" class="page active">
      <!-- Hero Banner -->
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">Verified culture / since 2021</span>
        <h1>THE PAIRS YOU'VE BEEN LOOKING FOR.</h1>
        <p>Authentic sneakers, streetwear &amp; random shit. Sourced from verified collectors, inspected by hand, and ready for your rotation.</p>
        <div class="btn-row">
          <button class="btn" onclick="go('shop')">SHOP SNEAKERS</button>
          <button class="btn light" onclick="scrollToSection('heat')">EXPLORE DROP</button>
        </div>
      </div>
      <div class="hero-image">
        <img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1200&q=85" alt="Air Jordan 1 Retro High OG">
        <div class="hero-stamp">
          VERIFIED<br>100%<br>AUTHENTIC
        </div>
      </div>
    </section>

    <!-- Trending Now -->
    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">The Rotation</span>
          <h2>TRENDING NOW</h2>
        </div>
        <a class="text-link" onclick="go('shop')">SHOP ALL →</a>
      </div>
      <div class="products" id="trending"></div>
    </section>

    <!-- Brand Grid -->
    <section class="section" style="padding-top:10px">
      <div class="section-head">
        <div>
          <span class="eyebrow">Shop The Icons</span>
          <h2>BY BRAND</h2>
        </div>
      </div>
      <div class="brand-grid" id="brandGrid">
        <div class="brand-tile" onclick="filterByBrand('', this)">ALL BRANDS</div>
        <div class="brand-tile" onclick="filterByBrand('Jordan', this)">JORDAN</div>
        <div class="brand-tile" onclick="filterByBrand('Nike', this)">NIKE</div>
        <div class="brand-tile" onclick="filterByBrand('adidas', this)">ADIDAS</div>
        <div class="brand-tile" onclick="filterByBrand('New Balance', this)">NEW BALANCE</div>
        <div class="brand-tile" onclick="filterByBrand('ASICS', this)">ASICS</div>
        <div class="brand-tile" onclick="filterByBrand('TRAVIS SCOTT', this)">TRAVIS SCOTT</div>
        <div class="brand-tile" onclick="filterByBrand('SUPREME', this)">SUPREME</div>
      </div>
    </section>

    <!-- Heat Drop Collection -->
    <section class="heat" id="heat">
      <div class="heat-main">
        <img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?auto=format&fit=crop&w=1300&q=85" alt="Curated sneaker heat">
        <div class="overlay">
          <span class="eyebrow" style="color: #fff">Curated Drop</span>
          <h2>THE HEAT COLLECTION</h2>
          <button class="btn white" onclick="go('shop')">EXPLORE THE DROP</button>
        </div>
      </div>
      <div class="heat-side">
        <div>
          <span class="heat-count">01 / 24</span>
          <p>Hard-to-find, never-overlooked pairs. A weekly edit of grails, limited collabs, and modern classics with real staying power.</p>
        </div>
        <div>
          <span class="eyebrow" style="color: #aaa">Editorial Selection</span>
          <h3 style="font-size:26px;letter-spacing:-0.05em;margin:10px 0 0">Built for collectors.<br>Worn by everyone.</h3>
        </div>
      </div>
    </section>

    <!-- Authenticity Promise -->
    <section class="section auth">
      <div class="auth-inner auth-grid">
        <div>
          <span class="eyebrow">Our Standard</span>
          <h2>AUTHENTICITY GUARANTEED.</h2>
          <p>Every single pair undergoes a rigorous physical inspection: stitch count, uv light verification, box labels, and production stamps. We don't sell fakes. Period.</p>
        </div>
        <div class="steps">
          <div class="step"><b>01</b><span>Source Verification</span></div>
          <div class="step"><b>02</b><span>Hands-On Verification</span></div>
          <div class="step"><b>03</b><span>Digital Authentication Stamp</span></div>
          <div class="step"><b>04</b><span>Fast & Insured Delivery</span></div>
        </div>
      </div>
    </section>

    <!-- Recently Added -->
    <section class="section">
      <div class="section-head">
        <div>
          <span class="eyebrow">Just Landed</span>
          <h2>RECENTLY ADDED</h2>
        </div>
        <a class="text-link" onclick="go('shop')">VIEW INVENTORY →</a>
      </div>
      <div class="products" id="recent"></div>
    </section>

    <!-- Streetwear Apparel Feature -->
    <section class="section" id="street">
      <div class="section-head">
        <div>
          <span class="eyebrow">Beyond the Pair</span>
          <h2>STREETWEAR</h2>
        </div>
      </div>
      <div class="streetwear">
        <div class="feature-card full-shot">
          <img src="supreme.jpg" alt="Supreme apparel and accessories">
          <div class="content">
            <span class="eyebrow" style="color:#fff">Apparel & Accessories</span>
            <h3>Archive worthy pieces.</h3>
            <button class="btn white" onclick="filterByBrand('SUPREME', null)">EXPLORE PICKS</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- SHOP / CATALOG PAGE -->
  <div id="shop" class="page">
    <div class="shop-top">
      <div>
        <span class="eyebrow">Authenticated Inventory</span>
        <h1>SHOP ALL</h1>
      </div>
      <span class="eyebrow" id="productTotal"></span>
    </div>
    <section class="section" style="padding-top:15px">
      <div class="shop-layout">
        <!-- Desktop Filters Sidebar -->
        <aside class="filters" aria-label="Product Filters">
          <div class="filter">
            <label for="filterSearch">SEARCH</label>
            <input id="filterSearch" placeholder="Search keywords..." oninput="handleSearchSync('desktop')">
          </div>
          <div class="filter">
            <label for="brandFilter">BRAND</label>
            <select id="brandFilter" onchange="renderShop()">
              <option value="">All Brands</option>
              <option value="Jordan">Jordan</option>
              <option value="Nike">Nike</option>
              <option value="adidas">adidas</option>
              <option value="New Balance">New Balance</option>
              <option value="ASICS">ASICS</option>
              <option value="TRAVIS SCOTT">Travis Scott</option>
              <option value="SUPREME">Supreme</option>
            </select>
          </div>
          <div class="filter">
            <label for="sizeFilter">US SIZE</label>
            <select id="sizeFilter" onchange="renderShop()">
              <option value="">All Sizes</option>
              <option value="8">US 8</option>
              <option value="8.5">US 8.5</option>
              <option value="9">US 9</option>
              <option value="9.5">US 9.5</option>
              <option value="10">US 10</option>
              <option value="10.5">US 10.5</option>
              <option value="11">US 11</option>
              <option value="12">US 12</option>
            </select>
          </div>
          <div class="filter">
            <label for="conditionFilter">CONDITION</label>
            <select id="conditionFilter" onchange="renderShop()">
              <option value="">All Conditions</option>
              <option value="New">Brand New (Deadstock)</option>
              <option value="Pre-owned">Pre-owned</option>
            </select>
          </div>
          <div class="filter">
            <label for="priceFilter">MAX PRICE ($)</label>
            <input id="priceFilter" type="number" placeholder="No limit" oninput="renderShop()">
          </div>
          <button class="clear-filters-btn" onclick="clearFilters()">Reset All Filters</button>
        </aside>

        <!-- Shop Content Area -->
        <div>
          <div class="shop-actions">
            <input id="mobileSearch" placeholder="Search sneakers, SKU, color..." oninput="handleSearchSync('mobile')">
            <select id="sort" onchange="renderShop()" aria-label="Sort products">
              <option value="featured">Sort: Featured</option>
              <option value="new">Sort: Newest First</option>
              <option value="low">Price: Low to High</option>
              <option value="high">Price: High to Low</option>
            </select>
          </div>
          <div class="products" id="shopProducts"></div>
        </div>
      </div>
    </section>
  </div>

  <!-- PRODUCT DETAIL PAGE -->
  <div id="product" class="page">
    <section class="product-page">
      <a class="back" onclick="go('shop')" role="button" tabindex="0">← BACK TO INVENTORY</a>
      <div class="detail">
        <div class="gallery" id="gallery"></div>
        <aside class="details" id="details"></aside>
      </div>
    </section>
  </div>

  <!-- ABOUT PAGE -->
  <div id="about" class="page">
    <section class="about">
      <span class="eyebrow">The Random Stock Story</span>
      <h1>BUILT AROUND THE PAIR.</h1>
      <p>Random Stock began with the belief that the right pair can mark a moment in time. We are collectors, wearers, and relentless students of the details—and we built the shop we always wanted to buy from: considered inventory, straightforward pricing, and zero doubt about authenticity.</p>
      <div class="about-hero">
        <img src="https://images.unsplash.com/photo-1514989940723-e8e51635b782?auto=format&fit=crop&w=1600&q=85" alt="Streetwear and sneaker community">
      </div>
      <h2 style="font-size: clamp(28px, 4vw, 44px); letter-spacing:-0.06em; max-width: 760px; font-weight:800; line-height:1.15">
        A better way to discover the pairs that matter—and give your own collection a next life.
      </h2>
    </section>
  </div>
  </main>

  <!-- NEWSLETTER SIGNUP -->
  <section class="newsletter">
    <div>
      <span class="eyebrow">Drop Alerts Only</span>
      <h2>GET THE HEAT FIRST.</h2>
      <p>Restocks, exclusive release access, and curated price drops.</p>
    </div>
    <form class="email-form" onsubmit="newsletter(event)">
      <input type="email" required placeholder="Enter your email address" aria-label="Email address">
      <button type="submit">SIGN UP</button>
    </form>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="foot-grid">
      <div>
        <a class="logo" href="#home" onclick="event.preventDefault(); go('home');">RANDOM&nbsp;<i>STOCK</i></a>
        <p style="color:#b5b3ad;max-width:240px;font-size:13px;margin:14px 0 0">
          Verified sneakers and streetwear for the permanent rotation.
        </p>
      </div>
      <div>
        <h4>SHOP</h4>
        <a onclick="shopNav('all')">New Arrivals</a>
        <a onclick="shopNav('all')">Sneakers</a>
        <a onclick="scrollToSection('street')">Streetwear</a>
        <a onclick="scrollToSection('heat')">Collections</a>
      </div>
      <div>
        <h4>AUTHENTICATION</h4>
        <a onclick="toast('Inspection guarantee verified on every pair.')">4-Step Verification</a>
        <a onclick="toast('Box condition is documented and inspected.')">Box Standards</a>
        <a onclick="toast('All orders ship fully insured.')">Shipping & Insurance</a>
        <a onclick="toast('Free returns within 7 days for unworn pairs.')">Return Policy</a>
      </div>
      <div>
        <h4>COMPANY</h4>
        <a onclick="go('about')">Our Story</a>
        <a onclick="toast('Contact us: support@randomstock.io')">Support</a>
        <a onclick="toast('Privacy policy is updated for 2026.')">Privacy Policy</a>
        <a onclick="toast('Terms of service available on request.')">Terms of Service</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Random Stock. ALL RIGHTS RESERVED.</span>
      <span>INSTAGRAM · TIKTOK · X · DISCORD</span>
    </div>
