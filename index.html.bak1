<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Random Stock — Verified sneakers & streetwear</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://images.unsplash.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#151515;--paper:#f5f4f1;--white:#fff;--line:#e4e2de;--muted:#73716d;--lime:#d7ff3f;--radius:4px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:14px Manrope,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}a{color:inherit;text-decoration:none}img{width:100%;display:block;object-fit:cover}.mono,.eyebrow{font:11px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}.eyebrow{color:var(--muted)}.announce{height:36px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;position:relative;font-size:10px;letter-spacing:.13em}.announce button{position:absolute;right:20px;background:transparent;color:#fff;font-size:17px}.announce.hide{display:none}.nav{height:78px;padding:0 clamp(18px,4vw,56px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(245,244,241,.94);backdrop-filter:blur(12px);position:sticky;top:0;z-index:20}.logo{font-size:21px;font-weight:800;letter-spacing:-1.4px}.logo i{font-style:normal;color:#777}.nav-links{display:flex;gap:25px;margin-left:45px;flex:1}.nav-links a{font-size:11px;font-weight:700;letter-spacing:.04em}.nav-links a:hover,.nav-links a.active{text-decoration:underline;text-underline-offset:7px}.actions{display:flex;gap:17px;align-items:center}.icon{background:none;padding:4px;font-size:20px;line-height:1;color:var(--ink);position:relative}.badge{position:absolute;right:-7px;top:-6px;width:15px;height:15px;border-radius:50%;font:9px 'DM Mono';display:grid;place-items:center;background:var(--ink);color:#fff}.hamb{display:none;background:none;font-size:24px}.page{display:none}.page.active{display:block}.hero{min-height:calc(100vh - 114px);display:grid;grid-template-columns:1.1fr .9fr;background:#d2d2ce;position:relative}.hero-copy{padding:clamp(45px,10vw,145px) clamp(22px,6vw,90px);align-self:center}.hero h1{font-size:clamp(48px,6.3vw,102px);line-height:.91;letter-spacing:-.08em;margin:22px 0 27px;max-width:720px}.hero p{max-width:370px;color:#454545;line-height:1.7;margin-bottom:31px}.hero-image{min-height:530px;position:relative;overflow:hidden}.hero-image img{height:100%;filter:grayscale(1);mix-blend-mode:multiply}.hero-stamp{position:absolute;bottom:28px;right:30px;color:#fff;width:106px;height:106px;border:1px solid #fff;border-radius:50%;padding:22px;text-align:center;display:grid;place-items:center;font:9px 'DM Mono';letter-spacing:.12em;line-height:1.4}.btn{background:var(--ink);color:#fff;border:1px solid var(--ink);padding:15px 23px;font-size:11px;font-weight:800;letter-spacing:.08em;transition:.2s}.btn:hover{background:#353535;transform:translateY(-2px)}.btn.light{background:transparent;color:var(--ink)}.btn.light:hover{background:var(--ink);color:#fff}.btn.white{background:#fff;color:var(--ink);border-color:#fff}.btn-row{display:flex;gap:10px;flex-wrap:wrap}.section{padding:clamp(55px,7vw,105px) clamp(18px,4vw,56px);max-width:1600px;margin:auto}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:35px}.section h2{font-size:clamp(31px,4vw,58px);letter-spacing:-.065em;line-height:1;margin:9px 0 0}.text-link{font-weight:800;font-size:11px;border-bottom:1px solid;padding-bottom:4px}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.product{min-width:0;position:relative}.product-image{background:#e9e8e5;aspect-ratio:1;overflow:hidden;position:relative}.product-image img{height:100%;transition:transform .5s}.product:hover img{transform:scale(1.045)}.wish{position:absolute;right:11px;top:11px;background:#fff;width:35px;height:35px;border-radius:50%;font-size:20px;z-index:2}.wish.saved{background:var(--lime)}.tag{position:absolute;top:11px;left:11px;background:var(--ink);color:#fff;padding:5px 8px;font:9px 'DM Mono';letter-spacing:.08em}.p-info{padding:13px 3px 4px}.brand{font:10px 'DM Mono';color:var(--muted);text-transform:uppercase}.name{font-weight:800;margin:4px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.color,.sizes{color:var(--muted);font-size:11px}.price{font-weight:800;margin-top:8px}.retail{color:#92908c;text-decoration:line-through;font-size:11px;margin-left:7px}.quick{width:100%;opacity:0;transform:translateY(5px);transition:.2s;margin-top:9px;padding:11px;background:var(--ink);color:#fff;font-size:10px;font-weight:800;letter-spacing:.08em}.product:hover .quick{opacity:1;transform:none}.brand-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.brand-tile{height:145px;background:#eae9e5;display:grid;place-items:center;font-size:18px;font-weight:800;letter-spacing:-.06em;transition:.2s}.brand-tile:hover{background:var(--lime);transform:translateY(-3px)}.heat{display:grid;grid-template-columns:1.3fr .7fr;min-height:640px;background:var(--ink);color:#fff}.heat-main{position:relative;overflow:hidden}.heat-main img{height:100%;opacity:.76;filter:grayscale(1)}.heat-main .overlay{position:absolute;left:clamp(20px,4vw,60px);bottom:50px}.heat h2{font-size:clamp(43px,5.4vw,80px);max-width:500px}.heat-side{padding:clamp(28px,4vw,60px);display:flex;flex-direction:column;justify-content:space-between}.heat-side p{color:#bebebb;max-width:290px;line-height:1.7}.heat-count{font:11px 'DM Mono';color:var(--lime)}.auth{background:#e3e0da;max-width:none}.auth-inner{max-width:1488px;margin:auto}.auth-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:8vw;align-items:end}.auth h2{font-size:clamp(40px,5vw,75px);max-width:660px}.steps{border-top:1px solid #afaca5}.step{display:flex;gap:23px;padding:18px 0;border-bottom:1px solid #afaca5}.step b{font:12px 'DM Mono';color:#777}.step span{font-size:18px;font-weight:800}.sell-banner{display:grid;grid-template-columns:.85fr 1.15fr;background:var(--lime)}.sell-copy{padding:clamp(42px,6vw,90px)}.sell-copy h2{font-size:clamp(40px,5vw,76px);line-height:.95;letter-spacing:-.075em;margin:15px 0 23px}.sell-img{height:520px}.sell-img img{height:100%;filter:grayscale(1) contrast(1.1)}.streetwear{display:grid;grid-template-columns:1fr 1fr;gap:17px}.feature-card{position:relative;min-height:500px;color:#fff;overflow:hidden}.feature-card img{height:100%;position:absolute;filter:grayscale(.5)}.feature-card div{position:absolute;inset:auto 28px 26px}.feature-card h3{font-size:31px;letter-spacing:-.06em;margin:7px 0}.newsletter{background:#fff;border-top:1px solid var(--line);padding:58px clamp(18px,4vw,56px);display:flex;justify-content:space-between;align-items:center;gap:30px}.newsletter h2{font-size:34px;letter-spacing:-.06em;margin:0 0 5px}.email-form{display:flex;width:min(100%,470px)}.email-form input{padding:15px;border:1px solid var(--ink);border-right:0;background:transparent;flex:1;min-width:0}.email-form button{padding:0 18px;background:var(--ink);color:#fff;font-weight:800;font-size:11px}.footer{background:var(--ink);color:#fff;padding:52px clamp(18px,4vw,56px) 25px}.foot-grid{display:grid;grid-template-columns:2fr repeat(4,1fr);gap:20px}.foot-grid h4{font:10px 'DM Mono';color:#999;margin:0 0 14px}.foot-grid a{display:block;margin:7px 0;font-size:12px;color:#e0e0e0}.foot-bottom{border-top:1px solid #373737;margin-top:50px;padding-top:18px;font-size:10px;color:#999;display:flex;justify-content:space-between}.shop-layout{display:grid;grid-template-columns:240px 1fr;gap:38px}.shop-top{padding:60px clamp(18px,4vw,56px) 25px;display:flex;justify-content:space-between;align-items:end}.shop-top h1,.sell-page h1,.about h1{font-size:clamp(45px,7vw,90px);letter-spacing:-.085em;line-height:.9;margin:14px 0 0}.filters{border-top:1px solid var(--line)}.filter{border-bottom:1px solid var(--line);padding:17px 0}.filter label{font-size:11px;font-weight:800;display:block;margin-bottom:10px}.filter select,.filter input{width:100%;padding:9px;border:1px solid #d5d2cc;background:transparent}.shop-actions{display:flex;gap:9px;margin-bottom:22px}.shop-actions input{padding:11px;border:1px solid #ccc;background:#fff;min-width:240px}.product-page{padding:40px clamp(18px,4vw,56px) 90px}.back{font-size:11px;font-weight:800}.detail{display:grid;grid-template-columns:1.2fr .8fr;gap:5vw;margin-top:26px}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gallery img{aspect-ratio:1;background:#e7e5e0}.details{position:sticky;top:100px;align-self:start}.details h1{font-size:35px;letter-spacing:-.06em;line-height:1.05;margin:7px 0}.detail-price{font-size:22px;font-weight:800;margin:20px 0}.meta{font-size:11px;color:var(--muted);line-height:1.9;border-top:1px solid var(--line);padding-top:14px}.size-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:12px 0 20px}.size{padding:11px 3px;background:#fff;border:1px solid #ddd}.size.selected{background:var(--ink);color:#fff}.detail-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.detail-btns .btn:first-child{grid-column:span 2}.perks{margin:23px 0;border-top:1px solid var(--line)}.perks p{margin:0;border-bottom:1px solid var(--line);padding:12px 0;font-size:12px}.overlay{position:fixed;inset:0;background:rgba(20,20,20,.45);opacity:0;pointer-events:none;transition:.25s;z-index:39}.overlay.open{opacity:1;pointer-events:auto}.drawer{position:fixed;right:0;top:0;height:100dvh;width:min(440px,100%);background:#fff;z-index:40;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column}.drawer.open{transform:none}.drawer-head{padding:22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.close{background:transparent;font-size:24px}.cart-list{padding:20px;overflow:auto;flex:1}.cart-row{display:grid;grid-template-columns:84px 1fr auto;gap:12px;margin-bottom:18px}.cart-row img{height:84px;background:#eee}.cart-row b{font-size:12px}.cart-row small{display:block;color:#777;margin:4px 0}.qty{display:flex;gap:7px;align-items:center;margin-top:7px}.qty button{border:1px solid #ddd;background:#fff;width:22px;height:22px}.cart-foot{border-top:1px solid var(--line);padding:20px}.total-line{display:flex;justify-content:space-between;margin:8px 0}.shipping-progress{height:5px;background:#e8e8e8;margin:10px 0 17px}.shipping-progress i{display:block;height:100%;width:72%;background:var(--lime)}.search-modal{position:fixed;inset:0;background:var(--paper);z-index:41;transform:translateY(-100%);transition:.35s;padding:40px clamp(20px,9vw,140px)}.search-modal.open{transform:none}.search-bar{display:flex;border-bottom:2px solid var(--ink);margin-top:90px}.search-bar input{font-size:clamp(28px,4vw,55px);letter-spacing:-.06em;padding:14px 0;border:0;background:none;outline:0;width:100%}.suggestions{margin-top:35px}.suggestions button{background:#fff;border:1px solid var(--line);padding:10px 14px;margin:5px}.sell-page,.about{padding:70px clamp(18px,8vw,130px) 100px}.sell-page>p,.about>p{max-width:580px;font-size:17px;line-height:1.7;margin:28px 0 45px}.sell-form{background:#fff;padding:clamp(20px,4vw,55px);display:grid;grid-template-columns:1fr 1fr;gap:17px;max-width:1050px}.sell-form label{font-size:11px;font-weight:800}.sell-form input,.sell-form select,.sell-form textarea{width:100%;padding:12px;margin-top:6px;border:1px solid #d8d6d0;background:#fafafa}.sell-form .full{grid-column:span 2}.upload{border:1px dashed #aaa;padding:34px;text-align:center;color:#777;background:#fafafa}.about-hero{height:450px;margin:50px 0}.about-hero img{height:100%;filter:grayscale(1)}.toast{position:fixed;left:50%;bottom:25px;transform:translate(-50%,100px);background:var(--ink);color:#fff;padding:13px 18px;z-index:80;font-size:12px;transition:.3s}.toast.show{transform:translate(-50%,0)}
    @media(max-width:800px){.nav{height:64px}.nav-links{display:none}.hamb{display:block;order:-1}.actions .account,.actions .heart{display:none}.hero{grid-template-columns:1fr;min-height:auto}.hero-copy{padding:70px 22px}.hero-image{min-height:380px;grid-row:1}.hero-stamp{display:none}.products{grid-template-columns:repeat(2,1fr);gap:12px}.quick{opacity:1;transform:none}.brand-grid{grid-template-columns:repeat(3,1fr)}.brand-tile{height:92px;font-size:14px}.heat,.sell-banner,.auth-grid,.streetwear{grid-template-columns:1fr}.heat{min-height:620px}.heat-main{height:360px}.heat-side{min-height:260px}.sell-img{height:340px}.newsletter{display:block}.email-form{margin-top:23px}.foot-grid{grid-template-columns:1fr 1fr}.foot-grid>div:first-child{grid-column:span 2}.shop-layout{grid-template-columns:1fr}.filters{display:none}.shop-top{padding-top:43px;display:block}.shop-actions{margin-top:30px}.shop-actions input{min-width:0;flex:1}.detail{grid-template-columns:1fr}.gallery{gap:6px}.details{position:static}.product-page{padding-top:25px}.sell-page,.about{padding:45px 20px 70px}.sell-form{grid-template-columns:1fr}.sell-form .full{grid-column:auto}.announce{font-size:9px}.section{padding-left:18px;padding-right:18px}.section-head{margin-bottom:25px}.section-head .text-link{display:none}}
  </style>
</head><body>
<div class="announce" id="announce">FREE SHIPPING ON ORDERS $150+ <button onclick="announce.classList.add('hide')">×</button></div>
<nav class="nav"><button class="hamb" onclick="toggleMenu()">☰</button><a class="logo" href="#" onclick="go('home')">RANDOM&nbsp;<i>STOCK</i></a><div class="nav-links"><a onclick="go('shop')">New Arrivals</a><a onclick="go('shop')">Sneakers</a><a onclick="scrollToSection('street')">Streetwear</a><a onclick="scrollToSection('heat')">Collections</a><a onclick="go('sell')">Sell Your Sneakers</a><a onclick="go('about')">About</a></div><div class="actions"><button class="icon" onclick="searchOpen()">⌕</button><button class="icon account" onclick="toast('Account sign-in coming soon.')">♙</button><button class="icon heart" onclick="go('shop')">♡<span class="badge" id="wishCount">0</span></button><button class="icon" onclick="cartOpen()">♧<span class="badge" id="cartCount">0</span></button></div></nav>
<main id="home" class="page active"><section class="hero"><div class="hero-copy"><span class="eyebrow">Verified culture / since 2021</span><h1>THE PAIRS YOU'VE BEEN LOOKING FOR.</h1><p>Authentic sneakers, streetwear &amp; random shit. Carefully sourced. Ready for your rotation.</p><div class="btn-row"><button class="btn" onclick="go('shop')">SHOP SNEAKERS</button><button class="btn light" onclick="go('sell')">SELL YOUR PAIRS</button></div></div><div class="hero-image"><img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1200&q=85" alt="Premium sneaker"><div class="hero-stamp">VERIFIED<br>PAIR<br>AUTHENTICITY</div></div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">The rotation</span><h2>TRENDING NOW</h2></div><a class="text-link" onclick="go('shop')">SHOP ALL →</a></div><div class="products" id="trending"></div></section>
<section class="section" style="padding-top:10px"><div class="section-head"><div><span class="eyebrow">Shop the icons</span><h2>BY BRAND</h2></div></div><div class="brand-grid"><div class="brand-tile">NIKE</div><div class="brand-tile">JORDAN</div><div class="brand-tile">adidas</div><div class="brand-tile">New Balance</div><div class="brand-tile">ASICS</div><div class="brand-tile">SUPREME</div><div class="brand-tile">TRAVIS SCOTT</div></div></section>
<section class="heat" id="heat"><div class="heat-main"><img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?auto=format&fit=crop&w=1300&q=85" alt="Sneaker collection"><div class="overlay"><span class="eyebrow" style="color:#fff">Curated for now</span><h2>THE HEAT COLLECTION</h2><button class="btn white" onclick="go('shop')">EXPLORE THE DROP</button></div></div><div class="heat-side"><div><span class="heat-count">01 / 24</span><p>Hard-to-find, never-overlooked pairs. A weekly edit of sneakers with real staying power.</p></div><div><span class="eyebrow" style="color:#aaa">This week's selection</span><h3 style="font-size:25px;letter-spacing:-.05em">Built for collectors.<br>Worn by everyone.</h3></div></div></section>
<section class="section auth"><div class="auth-inner auth-grid"><div><span class="eyebrow">Our standard</span><h2>AUTHENTICITY GUARANTEED.</h2><p>Every pair is inspected and verified before it reaches you. We don't sell fakes. Period.</p></div><div class="steps"><div class="step"><b>01</b><span>Sourced</span></div><div class="step"><b>02</b><span>Inspected</span></div><div class="step"><b>03</b><span>Authenticated</span></div><div class="step"><b>04</b><span>Shipped</span></div></div></div></section>
<section class="sell-banner"><div class="sell-copy"><span class="eyebrow">Got heat?</span><h2>TURN YOUR CLOSET INTO CASH.</h2><p>Got pairs you're ready to move? Get a quote and turn your sneakers into cash.</p><button class="btn" onclick="go('sell')">SELL YOUR SNEAKERS</button></div><div class="sell-img"><img src="https://images.unsplash.com/photo-1495555961986-6d4c1ecb7be3?auto=format&fit=crop&w=1200&q=85" alt="Sneaker lifestyle"></div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">Just landed</span><h2>RECENTLY ADDED</h2></div><a class="text-link" onclick="go('shop')">VIEW INVENTORY →</a></div><div class="products" id="recent"></div></section>
<section class="section" id="street"><div class="section-head"><div><span class="eyebrow">Beyond the pair</span><h2>STREETWEAR</h2></div></div><div class="streetwear"><div class="feature-card"><img src="https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1000&q=85" alt="Streetwear"><div><span class="eyebrow" style="color:#fff">New season</span><h3>Quiet essentials.</h3><button class="btn white" onclick="go('shop')">SHOP APPAREL</button></div></div><div class="feature-card"><img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85" alt="Fashion collection"><div><span class="eyebrow" style="color:#fff">Select pieces</span><h3>Archive worthy.</h3><button class="btn white" onclick="go('shop')">EXPLORE PICKS</button></div></div></div></section></main>
<main id="shop" class="page"><div class="shop-top"><div><span class="eyebrow">Authenticated inventory</span><h1>SHOP ALL</h1></div><span class="eyebrow" id="productTotal"></span></div><section class="section" style="padding-top:15px"><div class="shop-layout"><aside class="filters"><div class="filter"><label>SEARCH</label><input id="filterSearch" placeholder="Search products" oninput="renderShop()"></div><div class="filter"><label>BRAND</label><select id="brandFilter" onchange="renderShop()"><option value="">All brands</option><option>Nike</option><option>Jordan</option><option>adidas</option><option>New Balance</option><option>ASICS</option></select></div><div class="filter"><label>SIZE</label><select id="sizeFilter" onchange="renderShop()"><option value="">All sizes</option><option>8</option><option>9</option><option>10</option><option>11</option><option>12</option></select></div><div class="filter"><label>CONDITION</label><select id="conditionFilter" onchange="renderShop()"><option value="">All conditions</option><option>New</option><option>Pre-owned</option></select></div><div class="filter"><label>MAX PRICE</label><input id="priceFilter" type="number" placeholder="$ Any" oninput="renderShop()"></div></aside><div><div class="shop-actions"><input id="mobileSearch" placeholder="Search inventory" oninput="renderShop()"><select id="sort" onchange="renderShop()"><option value="featured">Featured</option><option value="new">Newest</option><option value="low">Price: Low to High</option><option value="high">Price: High to Low</option></select></div><div class="products" id="shopProducts"></div></div></div></section></main>
<main id="product" class="page"><section class="product-page"><a class="back" onclick="go('shop')">← BACK TO SHOP</a><div class="detail"><div class="gallery" id="gallery"></div><aside class="details" id="details"></aside></div></section></main>
<main id="sell" class="page"><section class="sell-page"><span class="eyebrow">Sell with Random Stock</span><h1>READY TO SELL?</h1><p>Send us the details, get an offer, and turn your sneakers into cash. We make moving your collection feel easy.</p><form class="sell-form" onsubmit="submitSell(event)"><label>Brand<select required><option value="">Choose brand</option><option>Nike</option><option>Jordan</option><option>adidas</option><option>New Balance</option><option>Other</option></select></label><label>Model<input required placeholder="e.g. Air Jordan 4"></label><label>Size<input required type="number" min="1" max="20" step=".5" placeholder="US size"></label><label>Colorway<input required placeholder="e.g. Military Blue"></label><label>Condition<select required><option value="">Choose condition</option><option>New / Deadstock</option><option>Excellent</option><option>Good</option></select></label><label>Purchase price<input type="number" placeholder="$"></label><label>Expected price<input type="number" placeholder="$"></label><label>Name<input required placeholder="Your full name"></label><label>Email<input required type="email" placeholder="you@email.com"></label><label>Phone<input required type="tel" placeholder="(555) 555-5555"></label><div class="full upload" onclick="document.getElementById('photos').click()"><input id="photos" type="file" multiple accept="image/*" hidden onchange="this.parentElement.lastChild.textContent=this.files.length+' photo(s) selected'">Drag photos here or click to upload<br><small>Show tags, soles, and any wear.</small></div><button class="btn full">GET MY OFFER</button></form></section></main>
<main id="about" class="page"><section class="about"><span class="eyebrow">The Random Stock story</span><h1>BUILT AROUND THE PAIR.</h1><p>Random Stock began with the belief that the right pair can mark a moment. We’re collectors, wearers, and students of the details—and we built the shop we wanted to buy from: considered inventory, straightforward pricing, and no questions about what’s in the box.</p><div class="about-hero"><img src="https://images.unsplash.com/photo-1514989940723-e8e51635b782?auto=format&fit=crop&w=1600&q=85" alt="Streetwear community"></div><h2 style="font-size:36px;letter-spacing:-.06em;max-width:720px">A better way to find the pairs that matter—and give your own collection a next life.</h2></section></main>
<section class="newsletter"><div><span class="eyebrow">No noise, only drops</span><h2>GET THE HEAT FIRST.</h2><p style="color:#777;margin:0">New drops, restocks, exclusive releases, and deals.</p></div><form class="email-form" onsubmit="newsletter(event)"><input type="email" required placeholder="Your email address"><button>SIGN UP</button></form></section><footer class="footer"><div class="foot-grid"><div><a class="logo">RANDOM&nbsp;<i>STOCK</i></a><p style="color:#999;max-width:190px;font-size:12px">Verified sneakers and streetwear for the rotation.</p></div><div><h4>SHOP</h4><a onclick="go('shop')">New Arrivals</a><a onclick="go('shop')">Sneakers</a><a>Streetwear</a><a>Collections</a></div><div><h4>SELL</h4><a onclick="go('sell')">Sell Your Sneakers</a><a>Seller FAQ</a><a>Shipping</a></div><div><h4>HELP</h4><a>Contact</a><a>FAQ</a><a>Shipping & Returns</a><a>Authentication</a></div><div><h4>COMPANY</h4><a onclick="go('about')">About</a><a>Our Story</a><a>Privacy</a><a>Terms</a></div></div><div class="foot-bottom"><span>© 2026 Random Stock. ALL RIGHTS RESERVED.</span><span>INSTAGRAM &nbsp; TIKTOK &nbsp; X</span></div></footer>
<div class="overlay" id="shade" onclick="cartClose()"></div><aside class="drawer" id="drawer"><div class="drawer-head"><b>YOUR BAG <span id="drawerCount"></span></b><button class="close" onclick="cartClose()">×</button></div><div class="cart-list" id="cartList"></div><div class="cart-foot"><small id="shippingText">You’re $150 away from FREE SHIPPING.</small><div class="shipping-progress"><i id="shippingBar"></i></div><div class="total-line"><span>Subtotal</span><b id="subtotal">$0</b></div><div class="total-line"><span>Estimated shipping</span><span id="shipping">$12</span></div><button class="btn" style="width:100%;margin-top:15px" onclick="toast('Checkout is ready to connect to your payment provider.')">CHECKOUT</button></div></aside>
<section class="search-modal" id="searchModal"><button class="close" style="position:absolute;right:25px;top:22px" onclick="searchClose()">×</button><div class="search-bar"><input id="globalSearch" placeholder="Search sneakers, brands, SKU…" oninput="globalSearch()"></div><div class="suggestions"><span class="eyebrow">Suggested searches</span><div><button onclick="setSearch('Jordan')">Jordan 4</button><button onclick="setSearch('Nike')">Nike</button><button onclick="setSearch('New Balance')">New Balance</button><button onclick="setSearch('streetwear')">Streetwear</button></div><div id="searchResults" class="products" style="margin-top:30px"></div></div></section><div class="toast" id="toast"></div>
<script>
const products=[
 {id:1,brand:'Jordan',name:'Air Jordan 1 Retro High OG',color:'Chicago Lost & Found',price:485,retail:180,condition:'New',sizes:['8','9','10','11','12'],year:2022,img:'https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=700&q=85',sku:'DZ5485-612'},
 {id:2,brand:'Nike',name:'Dunk Low Retro',color:'Panda',price:168,retail:115,condition:'New',sizes:['8','9','10','11'],year:2024,img:'https://images.unsplash.com/photo-1600269452121-4f2416e55c28?auto=format&fit=crop&w=700&q=85',sku:'DD1391-100'},
 {id:3,brand:'Jordan',name:'Air Jordan 4 Retro',color:'Military Blue',price:278,retail:215,condition:'New',sizes:['8','9','10','12'],year:2024,img:'https://images.unsplash.com/photo-1597045566677-8cf032ed6634?auto=format&fit=crop&w=700&q=85',sku:'FV5029-141'},
 {id:4,brand:'Nike',name:'Kobe 6 Protro',color:'Reverse Grinch',price:425,retail:190,condition:'New',sizes:['9','10','11'],year:2023,img:'https://images.unsplash.com/photo-1605348532760-6753d2c43329?auto=format&fit=crop&w=700&q=85',sku:'FV4921-600'},
 {id:5,brand:'adidas',name:'Yeezy Boost 350 V2',color:'Bone',price:210,retail:230,condition:'New',sizes:['8','9','10','11'],year:2022,img:'https://images.unsplash.com/photo-1518002171953-a080ee817e1f?auto=format&fit=crop&w=700&q=85',sku:'HQ6316'},
 {id:6,brand:'New Balance',name:'990v6 Made in USA',color:'Grey',price:235,retail:220,condition:'New',sizes:['8','9','10','11','12'],year:2024,img:'https://images.unsplash.com/photo-1539185441755-769473a23570?auto=format&fit=crop&w=700&q=85',sku:'U990GR6'},
 {id:7,brand:'ASICS',name:'Gel-Kayano 14',color:'Cream Black',price:172,retail:150,condition:'New',sizes:['8','9','10','11'],year:2024,img:'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=700&q=85',sku:'1201A019-108'},
 {id:8,brand:'Nike',name:'Air Max 1',color:'Chili 2.0',price:154,retail:150,condition:'Pre-owned',sizes:['9','10','11'],year:2023,img:'https://images.unsplash.com/photo-1603808033192-082d6919d3e1?auto=format&fit=crop&w=700&q=85',sku:'FD2370-101'}];
let cart=[],wishlist=[],current=products[0];const $=id=>document.getElementById(id),money=n=>'$'+n.toLocaleString();
function productCard(p){return `<article class="product"><div class="product-image" onclick="openProduct(${p.id})"><img src="${p.img}" alt="${p.name}"><span class="tag">${p.condition==='New'?'NEW':p.condition}</span><button class="wish ${wishlist.includes(p.id)?'saved':''}" onclick="event.stopPropagation();toggleWish(${p.id})">${wishlist.includes(p.id)?'♥':'♡'}</button></div><div class="p-info"><div class="brand">${p.brand}</div><div class="name">${p.name}</div><div class="color">${p.color}</div><div class="sizes">US ${p.sizes.slice(0,3).join(' · ')}${p.sizes.length>3?' · +':''}</div><div class="price">${money(p.price)} <span class="retail">${money(p.retail)}</span></div><button class="quick" onclick="addCart(${p.id})">QUICK ADD</button></div></article>`}
function renderHome(){ $('trending').innerHTML=products.slice(0,4).map(productCard).join('');$('recent').innerHTML=products.slice(4,8).map(productCard).join('') }
function renderShop(){let list=[...products],q=(($('filterSearch')?.value||'')+' '+($('mobileSearch')?.value||'')).toLowerCase(),brand=$('brandFilter')?.value,size=$('sizeFilter')?.value,condition=$('conditionFilter')?.value,max=+$('priceFilter')?.value;if(q.trim())list=list.filter(p=>(p.brand+' '+p.name+' '+p.color+' '+p.sku).toLowerCase().includes(q));if(brand)list=list.filter(p=>p.brand===brand);if(size)list=list.filter(p=>p.sizes.includes(size));if(condition)list=list.filter(p=>p.condition===condition);if(max)list=list.filter(p=>p.price<=max);let sort=$('sort')?.value;if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);if(sort==='new')list.sort((a,b)=>b.year-a.year);$('shopProducts').innerHTML=list.map(productCard).join('')||'<p>No pairs match those filters.</p>';$('productTotal').textContent=list.length+' PAIRS AVAILABLE'}
function go(page){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$(page).classList.add('active');window.scrollTo({top:0,behavior:'smooth'});cartClose()}
function scrollToSection(id){go('home');setTimeout(()=>$(id).scrollIntoView({behavior:'smooth'}),60)}
function openProduct(id){current=products.find(p=>p.id===id);$('gallery').innerHTML=[current.img,current.img,current.img,current.img].map((x,i)=>`<img src="${x}&sat=${i}" alt="${current.name}">`).join('');$('details').innerHTML=`<span class="eyebrow">${current.brand}</span><h1>${current.name}</h1><p class="color">${current.color}</p><div class="detail-price">${money(current.price)} <span class="retail">${money(current.retail)}</span></div><div class="meta">SKU: ${current.sku}<br>CONDITION: ${current.condition}</div><p class="eyebrow" style="margin-top:20px">Select size</p><div class="size-grid">${current.sizes.map((s,i)=>`<button class="size ${i===0?'selected':''}" onclick="selectSize(this)">${s}</button>`).join('')}</div><div class="detail-btns"><button class="btn" onclick="addCart(${current.id})">ADD TO BAG</button><button class="btn light" onclick="addCart(${current.id});toast('Ready for checkout.')">BUY NOW</button><button class="btn light" onclick="toggleWish(${current.id})">ADD TO WISHLIST</button></div><div class="perks"><p>✓ Authenticity Guarantee</p><p>✓ Secure Checkout</p><p>✓ Fast Shipping</p><p>✓ Easy Returns</p></div><p style="font-size:12px;line-height:1.7">Every Random Stock pair is independently inspected and shipped in protective packaging. This product may have minor variations from photographs.</p>`;go('product')}
function selectSize(el){document.querySelectorAll('.size').forEach(x=>x.classList.remove('selected'));el.classList.add('selected')}
function toggleWish(id){wishlist.includes(id)?wishlist=wishlist.filter(x=>x!==id):wishlist.push(id);$('wishCount').textContent=wishlist.length;renderHome();if($('shop').classList.contains('active'))renderShop();toast(wishlist.includes(id)?'Saved to wishlist.':'Removed from wishlist.')}
function addCart(id){let item=cart.find(x=>x.id===id);item?item.qty++:cart.push({id,qty:1,size:products.find(p=>p.id===id).sizes[0]});renderCart();cartOpen();toast('Added to your bag.')}
function renderCart(){let count=cart.reduce((a,x)=>a+x.qty,0),sub=cart.reduce((a,x)=>a+products.find(p=>p.id===x.id).price*x.qty,0);$('cartCount').textContent=count;$('drawerCount').textContent='('+count+')';$('cartList').innerHTML=cart.length?cart.map(x=>{let p=products.find(y=>y.id===x.id);return `<div class="cart-row"><img src="${p.img}" alt="${p.name}"><div><b>${p.name}</b><small>US ${x.size} · ${p.condition}</small><b>${money(p.price)}</b><div class="qty"><button onclick="changeQty(${x.id},-1)">−</button><span>${x.qty}</span><button onclick="changeQty(${x.id},1)">+</button><button style="width:auto;border:0;margin-left:7px;color:#777" onclick="removeCart(${x.id})">Remove</button></div></div></div>`}).join(''):'<p style="text-align:center;color:#777;margin-top:60px">Your bag is waiting for its first pair.</p>';$('subtotal').textContent=money(sub);let remain=Math.max(0,150-sub);$('shippingText').textContent=remain?`You’re ${money(remain)} away from FREE SHIPPING.`:'You unlocked FREE SHIPPING.';$('shippingBar').style.width=Math.min(100,sub/150*100)+'%';$('shipping').textContent=sub>=150?'FREE':'$12'}
function changeQty(id,n){let item=cart.find(x=>x.id===id);item.qty+=n;if(item.qty<1)removeCart(id);else renderCart()}function removeCart(id){cart=cart.filter(x=>x.id!==id);renderCart();toast('Removed from bag.')}
function cartOpen(){$('drawer').classList.add('open');$('shade').classList.add('open')}function cartClose(){$('drawer').classList.remove('open');$('shade').classList.remove('open')}
function searchOpen(){$('searchModal').classList.add('open');$('globalSearch').focus();globalSearch()}function searchClose(){$('searchModal').classList.remove('open')}function globalSearch(){let q=$('globalSearch').value.toLowerCase(),r=products.filter(p=>(p.brand+p.name+p.color+p.sku).toLowerCase().includes(q)).slice(0,4);$('searchResults').innerHTML=q?r.map(productCard).join(''):''}function setSearch(q){$('globalSearch').value=q;globalSearch()}
function toggleMenu(){go('shop')}function newsletter(e){e.preventDefault();e.target.reset();toast('You’re on the list. Welcome to Random Stock.')}function submitSell(e){e.preventDefault();e.target.reset();toast('Request received. We’ll send your offer shortly.')}let timer;function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');clearTimeout(timer);timer=setTimeout(()=>$('toast').classList.remove('show'),2800)}
renderHome();renderShop();renderCart();
</script></body></html>
