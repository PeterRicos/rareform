# qrcode.js is vendored, byte-for-byte, from qrcode-generator 1.4.4 (MIT), and the
# comment above its <script> tag in index.html records the upstream SHA-256. A
# Windows checkout would otherwise rewrite its line endings to CRLF and the file
# would no longer hash to that value, so this one file is always checked out as it
# is stored. (Everything else is hashed with line endings folded, so it does not
# matter there — see the note in stamp-assets.js.)
qrcode.js text eol=lf

# A clip is binary, and nothing here should ever treat one as text. A tool that decodes
# a video as UTF-8 and re-encodes it replaces every byte it cannot decode with U+FFFD:
# the file keeps a valid-looking header, doubles in length, and every browser then
# refuses to open it. Marking .mp4 binary keeps git and its diff/patch helpers out of
# the bytes, whatever the local editor or checkout decides about line endings.
*.mp4 binary